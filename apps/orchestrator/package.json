{
  "name": "@umbra/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "register": "tsx --env-file=../../.env src/setup.ts",
    "smoke": "tsx --env-file=../../.env src/scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@terminal3/t3n-sdk": "^3.5.2",
    "@umbra/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "viem": "^2.23.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
